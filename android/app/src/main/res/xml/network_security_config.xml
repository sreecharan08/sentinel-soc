<?xml version="1.0" encoding="utf-8"?>
<!--
  Demo build: the laptop address changes between networks (Wi-Fi, hotspot, USB reverse, emulator), so plain HTTP
  is allowed. Production builds should use HTTPS and drop this file.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
