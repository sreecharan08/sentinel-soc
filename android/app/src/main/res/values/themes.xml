<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Sentinel" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/bg_1</item>
        <item name="colorPrimaryDark">@color/bg_0</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg_0</item>
        <item name="android:statusBarColor">@color/bg_0</item>
        <item name="android:navigationBarColor">@color/bg_0</item>
        <!-- shortcut: this app draws its own fixed status/nav bar colours instead of edge-to-edge insets;
             Android 15+ enforces edge-to-edge by default for targetSdk 35+, so opt out until the layouts
             handle WindowInsets themselves. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <item name="android:textColorPrimary">@color/text_1</item>
        <item name="android:textColorSecondary">@color/text_2</item>
        <item name="android:colorControlHighlight">@color/bg_2</item>
    </style>

    <!-- Launch: animated shield on the app background, then the normal theme. -->
    <style name="Theme.Sentinel.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_0</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">900</item>
        <item name="postSplashScreenTheme">@style/Theme.Sentinel</item>
    </style>

    <!-- The result screen is a bottom sheet: see-through window, the sheet draws its own scrim and motion. -->
    <style name="Theme.Sentinel.Sheet">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="Text.Title" parent="">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_1</item>
    </style>

    <style name="Text.Body" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_1</item>
    </style>

    <style name="Text.Caption" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_3</item>
    </style>

    <style name="Text.Section" parent="">
        <item name="android:textSize">10.5sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/text_3</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Mono" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/text_3</item>
    </style>

    <style name="Button.Primary" parent="">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/on_fill</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Button.Secondary" parent="">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/text_1</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
